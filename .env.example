# Example environment variables. Export them or use your service manager's EnvironmentFile.
# The binary does not automatically load this file. Development must override the network.
NETWORK=finney
NETUID=46
CHAIN_ENDPOINT=
PLATFORM_EPOCH_SUMMARY_URL=http://127.0.0.1:8092/validator/v1/epoch-summaries/latest
# A separate Platform deployment must override both URL and signer.
PLATFORM_SIGNER=REPLACE_WITH_PLATFORM_SS58
VALIDATOR_STATE_PATH=/var/lib/sn46-validator/state.json
POLL_INTERVAL_SECS=300
TRANSACTION_TIMEOUT_SECS=60
WALLET_NAME=validator
WALLET_HOTKEY=default
WALLET_PATH=~/.bittensor/wallets
